from collections import deque

class CallCenter:
    def __init__(self):
        self.call_queue = deque()

    def addCall(self, customerID, callTime):
        self.call_queue.append((customerID, callTime))
        print(f"Call added: CustomerID={customerID}, Time={callTime} min")

    def answerCall(self):
        if self.isQueueEmpty():
            print("No calls to answer!")
        else:
            customerID, callTime = self.call_queue.popleft()
            print(f"Answering call from CustomerID={customerID}, Time={callTime} min")

    def viewQueue(self):
        if self.isQueueEmpty():
            print("No pending calls in queue.")
        else:
            print("Pending Calls in Queue:")
            for customerID, callTime in self.call_queue:
                print(f"  CustomerID={customerID}, Time={callTime} min")

    def isQueueEmpty(self):
        return len(self.call_queue) == 0


# Menu-driven program
def main():
    center = CallCenter()

    while True:
        print("\n--- Call Center Menu ---")
        print("1. Add Call")
        print("2. Answer Call")
        print("3. View Call Queue")
        print("4. Check if Queue is Empty")
        print("5. Exit")

        choice = input("Enter your choice (1-5): ")

        if choice == "1":
            customerID = input("Enter Customer ID: ")
            callTime = input("Enter Call Time (in minutes): ")
            center.addCall(customerID, callTime)

        elif choice == "2":
            center.answerCall()

        elif choice == "3":
            center.viewQueue()

        elif choice == "4":
            print("Is queue empty?", center.isQueueEmpty())

        elif choice == "5":
            print("Exiting... Goodbye!")
            break

        else:
            print("Invalid choice! Please try again.")


if __name__ == "__main__":
    main()


