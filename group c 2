class HashTable:
    def __init__(self, size=10):
        self.size = size
        self.table = [None] * size   # empty slots
        self.deleted = "<deleted>"   # marker for deleted keys

    def hash_function(self, key):
        return key % self.size

    def insert(self, key):
        index = self.hash_function(key)
        start_index = index  # remember start for full loop check

        while self.table[index] not in (None, self.deleted):
            if self.table[index] == key:
                print("Key already exists!")
                return
            index = (index + 1) % self.size
            if index == start_index:
                print("Hash table is full!")
                return

        self.table[index] = key
        print(f"Inserted key {key}")

    def search(self, key):
        index = self.hash_function(key)
        start_index = index

        while self.table[index] is not None:
            if self.table[index] == key:
                return index
            index = (index + 1) % self.size
            if index == start_index:
                break
        return None

    def delete(self, key):
        index = self.search(key)
        if index is not None:
            self.table[index] = self.deleted
            print(f"Key {key} deleted")
        else:
            print("Key not found")

    def display(self):
        for i in range(self.size):
            print(f"Index {i}: {self.table[i]}")


# ---------------- Main Program ----------------
if __name__ == "__main__":
    ht = HashTable()

    while True:
        print("\n--- Hash Table Operations (Linear Probing) ---")
        print("1. Insert")
        print("2. Search")
        print("3. Delete")
        print("4. Display")
        print("5. Exit")

        choice = int(input("Enter your choice: "))

        if choice == 1:
            key = int(input("Enter key (integer): "))
            ht.insert(key)

        elif choice == 2:
            key = int(input("Enter key to search: "))
            result = ht.search(key)
            if result is not None:
                print(f"Key {key} found at index {result}")
            else:
                print("Key not found")

        elif choice == 3:
            key = int(input("Enter key to delete: "))
            ht.delete(key)

        elif choice == 4:
            ht.display()

        elif choice == 5:
            print("Exiting program...")
            break

        else:
            print("Invalid choice! Try again.")
